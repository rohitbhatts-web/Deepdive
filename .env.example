# Copy to .env and fill in. Never commit .env.
MESH_API_KEY=your-mesh-api-key-here
MESH_BASE_URL=https://api.meshapi.ai/v1
DATABASE_PATH=data/deepdive.db
API_URL=http://127.0.0.1:8000
# Phase 2 research. Models must exist on Mesh; there is deliberately no default.
PLANNER_MODEL=
RESEARCHER_MODEL=
# Web search: https://tavily.com (free tier, no card; 1 credit per basic search)
TAVILY_API_KEY=your-tavily-api-key-here
